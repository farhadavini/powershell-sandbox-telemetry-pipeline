# Copy to .env and fill in, or export these in your shell before running.
# Only the VM password is read from the environment; everything else is passed
# as a command-line flag (see the README / --help).

# Password of the VM user the pipeline logs into over WinRM.
MALWARE_VM_PASSWORD=your-vm-password

# Example run (VM name, snapshot, WinRM host, paths are CLI flags):
#   set MALWARE_VM_PASSWORD=...            (Windows cmd)
#   $env:MALWARE_VM_PASSWORD="..."         (PowerShell)
#   python malware_executor.py --vm-name "sandbox-vm" --snapshot-name "clean-baseline" \
#       --input-dir input\malware --output-dir output --observation-window 30
